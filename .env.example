# Copy to .env locally. Never commit real values.
HEARTBEAT_TOKEN=
ALLOWED_ORIGIN=http://127.0.0.1:5051
DATA_DIR=./data
PORT=5051

# Public edition supports OpenAI-compatible chat/completions endpoints.
# LLM_BASE_URL must include /v1 when required by your provider.
LLM_BASE_URL=https://api.example.invalid/v1
LLM_API_KEY=
LLM_MODEL=

# Optional. Leave blank to use browser queue delivery without mobile push.
BARK_KEY=
FRONTEND_URL=

HEARTBEAT_TZ=Asia/Shanghai
DAY_START_HOUR=10
NIGHT_START_HOUR=0
DAY_INTERVAL_MIN=60
NIGHT_INTERVAL_MIN=180
CHECK_INTERVAL_DAY_SEC=600
CHECK_INTERVAL_NIGHT_SEC=7200
CONTEXT_MAX_MESSAGES=40
