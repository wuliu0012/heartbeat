[Unit]
Description=Independent Heartbeat API
After=network-online.target

[Service]
Type=simple
User=heartbeat
Group=heartbeat
WorkingDirectory=/opt/heartbeat
EnvironmentFile=/opt/heartbeat/.env
ExecStart=/opt/heartbeat/.venv/bin/gunicorn --workers 1 --bind 127.0.0.1:5051 --timeout 30 'app:create_app()'
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/heartbeat/data

[Install]
WantedBy=multi-user.target
